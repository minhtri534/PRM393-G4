# App environment
ASPNETCORE_ENVIRONMENT=Production

# API port exposed by docker compose
API_PORT=3000

# -------- Local SQL Server (docker) --------
SA_PASSWORD=123456
DB_NAME=DLSS_Db

# Connection string used by API/migrator in local profile
# Important: Server must be the docker service name (sqlserver), not localhost.
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=sqlserver,1433;Database=DLSS_Db;User Id=sa;Password=123456;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true

# Optional JWT override
JWT__SIGNINGKEY=CHANGE_ME_PROD_SIGNING_KEY_AT_LEAST_32_CHARS_LONG

# -------- Email / OTP (Gmail SMTP example) --------
# Use Console to log OTP in backend logs and return devOtp in API response.
# Use Smtp to send real verification emails.
EMAIL__PROVIDER=Console
EMAIL__FROMADDRESS=noreply@dlss.local
EMAIL__FROMNAME=DLSS
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# EMAIL__PROVIDER=Smtp
# EMAIL__SMTPHOST=smtp.gmail.com
# EMAIL__SMTPPORT=587
# EMAIL__SMTPUSERNAME=your@gmail.com
# EMAIL__SMTPPASSWORD=your-app-password
# EMAIL__FROMADDRESS=your@gmail.com
# EMAIL__SMTPUSESSL=true
