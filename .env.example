# Copy this file to `.env` in the repo root and fill in your Gmail App Password.
# Do NOT commit `.env` (it is gitignored).

# -------- Email / OTP --------
# Console = OTP only in backend logs (no real email)
# Smtp    = send real verification emails via Gmail
EMAIL__PROVIDER=Smtp
EMAIL__FROMNAME=DLSS
EMAIL__FROMADDRESS=your@gmail.com
EMAIL__SMTPHOST=smtp.gmail.com
EMAIL__SMTPPORT=587
EMAIL__SMTPUSERNAME=your@gmail.com
EMAIL__SMTPPASSWORD=your-16-char-app-password
EMAIL__SMTPUSESSL=true
